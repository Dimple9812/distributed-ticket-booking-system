# Copy to .env and replace every placeholder. Never commit .env.

# PostgreSQL
DB_NAME=ticketing
DB_USERNAME=ticketing
DB_PASSWORD=change-me-db-password
DB_URL=jdbc:postgresql://localhost:5432/ticketing

# Redis / Kafka (host-side addresses; Compose overrides these for the app container)
REDIS_HOST=localhost
REDIS_PORT=6379
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# JWT signing key: at least 32 characters of random data.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=replace-with-at-least-32-random-characters

# Optional: bootstrap an ADMIN account on startup (skipped when blank)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password

# Booking behaviour
HOLD_TTL=PT5M
REDIS_FAILURE_MODE=DB_ONLY
